<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" >

    <application
        android:allowBackup="false"
        android:name=".MainApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Download the QR scanner module at install time instead of on first use -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />
        <activity
            android:name="io.github.hdghg.sevenhandshakes.MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Offers the app when another app opens a YAML file. MainActivity then shows the import screen.
                Apps do not agree on the MIME type of YAML, hence the list.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="text/x-yaml" />
                <data android:mimeType="text/vnd.yaml" />
            </intent-filter>
            <!--
                Lists the app in the share menu for a YAML file. A shared file has no uri to match
                a file name against, so only the MIME type tells: a YAML file shared as plain text
                or as unknown binary data does not list the app.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="text/x-yaml" />
                <data android:mimeType="text/vnd.yaml" />
            </intent-filter>
            <!--
                Many apps hand a YAML file over as plain text or as unknown binary data.
                Those are recognised by the file name, when the sending app puts it in the uri.
                pathSuffix needs Android 12; the patterns do the same for older versions, where
                ".*" stops at the first dot, so there is one pattern per number of dots in the path.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathSuffix=".yaml" />
                <data android:pathSuffix=".yml" />
                <data android:pathPattern=".*\\.yaml" />
                <data android:pathPattern=".*\\..*\\.yaml" />
                <data android:pathPattern=".*\\..*\\..*\\.yaml" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.yaml" />
                <data android:pathPattern=".*\\.yml" />
                <data android:pathPattern=".*\\..*\\.yml" />
                <data android:pathPattern=".*\\..*\\..*\\.yml" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.yml" />
            </intent-filter>
            <!--
                Opens a review or contact link (see Hs7Link), from a browser or any app that shows links.
                The scheme must match Hs7Link.SCHEME, the hosts ReviewLink.HOST and ContactLink.HOST.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hs7" />
                <data android:host="review" />
                <data android:host="contact" />
            </intent-filter>
        </activity>
        <!-- Lets the share menu hand export files to other apps -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
